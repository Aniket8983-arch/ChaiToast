# ============================================================
# SmartWaste 360 — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ----- Application -----
APP_NAME="SmartWaste 360"
APP_VERSION="1.0.0"
DEBUG=true

# ----- Database -----
# SQLite (local development)
DATABASE_URL=sqlite:///./data/smartwaste.db
# PostgreSQL (production — uncomment and fill in)
# DATABASE_URL=postgresql://user:password@host:5432/smartwaste

# ----- AI Inference Service -----
# Runs as a separate process on port 8001
INFERENCE_SERVICE_URL=http://localhost:8001

# ----- Hardware / Serial -----
# Windows: COM4, COM5, etc.  Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0
SERIAL_PORT=COM4
BAUD_RATE=115200
SERIAL_TIMEOUT=2

# ----- AI Thresholds -----
CONFIDENCE_THRESHOLD=0.70
BIN_WARNING_THRESHOLD=0.80
BIN_CRITICAL_THRESHOLD=0.95

# ----- Simulation -----
# Set to true to enable background simulation of sensor + GPS data
SIMULATION_ENABLED=true
SIMULATION_BIN_INTERVAL_SECONDS=15
SIMULATION_GPS_INTERVAL_SECONDS=5

# ----- CORS -----
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Security (fill in for production) -----
SECRET_KEY=change-this-to-a-random-secret-key-in-production

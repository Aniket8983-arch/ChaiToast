# ============================================================
# SmartWaste 360 — .gitignore
# ============================================================

# ----- Secrets (NEVER commit) -----
.env
*.env
.env.local
.env.production

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
venv/
.venv/
env/
.env/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ----- Database (SQLite) -----
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal
*.sqlite
*.sqlite3

# ----- Node / Frontend -----
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
.cache/

# ----- Logs -----
*.log
waste_log.csv
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Original dataset (too large for git) -----
dataset/

# ----- AI Model (too large for git — store in Git LFS or separate artifact store) -----
# models/waste_model.h5   ← uncomment this line to exclude the model from git

# ----- OS artifacts -----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ----- Editor -----
.vscode/settings.json
.idea/
*.iml

# ----- Alembic -----
alembic/versions/__pycache__/
